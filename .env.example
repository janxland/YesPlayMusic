VUE_APP_NETEASE_API_URL=/api
VUE_APP_ELECTRON_API_URL=/api
VUE_APP_ELECTRON_API_URL_DEV=http://127.0.0.1:10754
VUE_APP_LASTFM_API_KEY=
VUE_APP_LASTFM_API_SHARED_SECRET=
DEV_SERVER_PORT=8080

# 生产环境静态资源 CDN 路径（vue.config.js publicPath，留空则使用 /）
# 示例：https://cdn.example.com/www/music/dist/
VUE_APP_PUBLIC_PATH=

# 开发环境 API 代理目标（vue.config.js devServer.proxy）
DEV_SERVER_API_PROXY_TARGET=http://127.0.0.1:3000
DEV_SERVER_API_PATH_REWRITE=/

# 腾讯云 COS 部署（scripts/deploy-cdn.js）
# ⚠️ 已改为 OAuth→STS 临时密钥：不再需要填真实密钥！
#   先执行 pnpm roginx-login（浏览器 OAuth 登录），deploy-cdn.js 会自动获取 30min STS 临时密钥
#   以下 COS_SECRET_ID/KEY 仅保留给历史/匿名模式，正常情况请留空
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=mybox-1257251314
COS_REGION=ap-chengdu
COS_PREFIX=www/music/dist
COS_DOMAIN=
COS_CDN_DOMAIN=https://mybox-1257251314.cos.ap-chengdu.myqcloud.com
COS_ANONYMOUS=false
# OAuth 配置名（对应 eorder-server storage_config 的 name；默认 music，无需修改）
COS_CONFIG_NAME=music
# OAuth 服务地址（默认 edu.roginx.ink，无需修改）
ROGINX_OAUTH_BASE=https://edu.roginx.ink/api
