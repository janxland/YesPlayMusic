# YesPlayMusic 生产环境配置
# 静态资源走 COS（music.roginx.ink 只服务 index.html，资源走 CDN 不占服务器带宽）
VUE_APP_PUBLIC_PATH=https://mybox-1257251314.cos.ap-chengdu.myqcloud.com/www/music/dist/

# API 走 music.roginx.ink/api/ 反代（nginx 配置 /api/ → 127.0.0.1:3000）
VUE_APP_NETEASE_API_URL=/api
VUE_APP_ELECTRON_API_URL=/api

# COS 部署（deploy-cdn.js 走 OAuth→STS，无需密钥；以下仅 STS 返回覆盖前的前置值，可留空）
COS_BUCKET=mybox-1257251314
COS_REGION=ap-chengdu
COS_PREFIX=www/music/dist
COS_CONFIG_NAME=music
